# Browser-safe Supabase settings (prefixed with VITE_ so Vite exposes them).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only settings. Never expose the service-role or Gemini key in browser code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"
CHAT_RATE_LIMIT_MAX="10"
CHAT_RATE_LIMIT_WINDOW_SECONDS="60"
CHAT_DAILY_LIMIT_MAX="100"
CHAT_REQUEST_STALE_SECONDS="90"

# Optional privacy-safe error reporting. Leave blank to disable Sentry.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"

# Use the deployed origin in production. This must be in Supabase Auth redirect URLs.
APP_URL="http://localhost:3000"
